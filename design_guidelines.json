{
  "design_system": {
    "identity": {
      "name": "NetOps Pro",
      "archetype": "The Performance Pro",
      "vibe": "Tactical, Precision, High-Density, Dark Mode First",
      "principles": [
        "Data Density over White Space (for dashboards)",
        "Status Visibility is King (Green/Red/Amber must pop)",
        "Glassmorphism for Context (Overlays/Modals)",
        "Monospace for Technical Data (IPs, MACs, IDs)"
      ]
    },
    "typography": {
      "font_family": {
        "headings": "Chivo, sans-serif",
        "body": "Inter, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "usage": {
        "h1": "text-4xl font-bold tracking-tight text-white",
        "h2": "text-2xl font-semibold tracking-tight text-zinc-100",
        "h3": "text-xl font-medium text-zinc-200",
        "body": "text-sm text-zinc-400 leading-relaxed",
        "label": "text-xs font-medium uppercase tracking-wider text-zinc-500",
        "data": "font-mono text-xs text-zinc-300"
      }
    },
    "colors": {
      "theme": "dark",
      "palette": {
        "background": {
          "default": "bg-zinc-950",
          "card": "bg-zinc-900/50",
          "sidebar": "bg-zinc-950/95"
        },
        "primary": {
          "default": "bg-blue-600",
          "hover": "hover:bg-blue-500",
          "text": "text-blue-500"
        },
        "status": {
          "success": "text-emerald-500 bg-emerald-500/10 border-emerald-500/20",
          "warning": "text-amber-500 bg-amber-500/10 border-amber-500/20",
          "error": "text-rose-500 bg-rose-500/10 border-rose-500/20",
          "neutral": "text-zinc-400 bg-zinc-400/10 border-zinc-400/20"
        },
        "border": {
          "default": "border-zinc-800",
          "active": "border-zinc-700"
        }
      }
    },
    "layout": {
      "spacing": {
        "container_padding": "p-6 md:p-8",
        "section_gap": "gap-6",
        "card_padding": "p-5"
      },
      "grid": {
        "dashboard": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4",
        "detail_view": "grid grid-cols-1 lg:grid-cols-3 gap-6"
      },
      "radius": "rounded-md"
    },
    "components": {
      "cards": {
        "style": "bg-zinc-900/40 backdrop-blur-sm border border-zinc-800/60 shadow-sm hover:border-zinc-700 transition-colors",
        "header": "border-b border-zinc-800/60 pb-3 mb-3"
      },
      "buttons": {
        "primary": "bg-blue-600 hover:bg-blue-500 text-white shadow-[0_0_15px_rgba(37,99,235,0.3)]",
        "secondary": "bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700",
        "ghost": "hover:bg-zinc-800/50 text-zinc-400 hover:text-zinc-100",
        "destructive": "bg-rose-900/30 text-rose-500 hover:bg-rose-900/50 border border-rose-900/50"
      },
      "inputs": {
        "style": "bg-zinc-950 border-zinc-800 focus:border-blue-500 focus:ring-1 focus:ring-blue-500/20 placeholder:text-zinc-600"
      },
      "badges": {
        "base": "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border"
      }
    },
    "visual_enhancers": {
      "glassmorphism": "backdrop-blur-md bg-zinc-950/80 border-b border-zinc-800",
      "glow": "shadow-[0_0_20px_-5px_rgba(59,130,246,0.15)]",
      "gradients": "bg-gradient-to-b from-zinc-800/50 to-zinc-900/50"
    }
  },
  "assets": {
    "images": {
      "login_hero": {
        "url": "https://images.unsplash.com/photo-1691435828932-911a7801adfb?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA1OTV8MHwxfHNlYXJjaHwxfHxuZXR3b3JrJTIwc2VydmVyJTIwcm9vbSUyMGRhcmslMjBibHVlJTIwbGlnaHRzfGVufDB8fHx8MTc3MTgwMjg3OXww&ixlib=rb-4.1.0&q=85",
        "alt": "Server room with blue lights",
        "usage": "Login page right side background"
      },
      "dashboard_bg": {
        "url": "https://images.unsplash.com/photo-1759661881353-5b9cc55e1cf4?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2NDF8MHwxfHNlYXJjaHwxfHxhYnN0cmFjdCUyMGN5YmVyJTIwc2VjdXJpdHklMjB0ZWNobm9sb2d5JTIwYmFja2dyb3VuZCUyMGRhcmt8ZW58MHx8fHwxNzcxODAyODgwfDA&ixlib=rb-4.1.0&q=85",
        "alt": "Abstract cyber security code",
        "usage": "Subtle overlay or empty state background"
      },
      "support_avatar": {
        "url": "https://images.unsplash.com/photo-1724260793422-7754e5d06fbe?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1Nzd8MHwxfHNlYXJjaHwxfHx0ZWNobmljYWwlMjBzdXBwb3J0JTIwZW5naW5lZXIlMjB3b3JraW5nJTIwb24lMjBjb21wdXRlcnxlbnwwfHx8fDE3NzE4MDI4ODJ8MA&ixlib=rb-4.1.0&q=85",
        "alt": "Support Engineer",
        "usage": "Testimonial or Team section in Portal"
      }
    },
    "icons": {
      "library": "lucide-react",
      "style": "stroke-width={1.5} className='w-5 h-5'"
    }
  },
  "page_specifics": {
    "login": {
      "layout": "Split screen (50/50 on desktop)",
      "features": "Glassmorphism form container, animated gradient border on input focus"
    },
    "dashboard": {
      "layout": "Bento Grid",
      "widgets": [
        "Stats Cards (Total Tickets, Open, SLA Breached)",
        "Recent Activity Feed (List)",
        "Ticket Volume Chart (Area Chart)",
        "Technician Performance (Bar Chart)"
      ]
    },
    "ticket_detail": {
      "layout": "3-Column: Left (Nav), Center (Chat/History), Right (Meta/Actions)",
      "features": "Timeline view for updates, Code block styling for logs"
    }
  },
  "instructions_to_main_agent": [
    "Use 'lucide-react' for all icons.",
    "Implement 'recharts' for all data visualization. Use custom tooltips with dark theme styling.",
    "Ensure all text inputs have 'data-testid' attributes.",
    "Use 'sonner' for notifications (success/error toasts).",
    "Strictly follow the dark mode color palette. Do not use light mode unless toggled (but default is dark).",
    "For tables, use 'Table' component from shadcn but add 'whitespace-nowrap' and 'text-sm' for density.",
    "Status badges must use the specific color combinations defined in 'colors.status'.",
    "Sidebar must be collapsible on mobile.",
    "Use 'date-fns' for date formatting (e.g., 'dd MMM yyyy HH:mm')."
  ],
  "universal_guidelines": {
    "do_not": [
      "Do not use gradients for text.",
      "Do not use rounded-full for main buttons (use rounded-md).",
      "Do not use pure black (#000000) for backgrounds, use Zinc-950 (#09090b)."
    ],
    "must_do": [
      "Add 'transition-all duration-200' to interactive elements.",
      "Use 'backdrop-blur' for sticky headers.",
      "Ensure high contrast for text (Zinc-400 for secondary, Zinc-100 for primary)."
    ]
  }
}